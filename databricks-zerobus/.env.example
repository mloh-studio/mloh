# Copy to .env and `set -a; source .env; set +a` before running the local producers.
ZEROBUS_ENDPOINT=https://<workspace-id>.zerobus.<region>.cloud.databricks.com
DATABRICKS_HOST=https://<workspace-host>
ZEROBUS_TABLE=workspace.iot_telemetry.sensor_events_raw
ZEROBUS_CLIENT_ID=
ZEROBUS_CLIENT_SECRET=
